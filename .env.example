# Ultrabridge Ledger Processor config
# Copy to .env and fill in values

# Where Tools for Boox uploads day JSON files via WebDAV
LEDGER_JSON_DIR=/docker/ultrabridge/ultrabridge-data/tab8/toolsboox/ToolsForBoox/json

# State file (tracks which files have been processed)
LEDGER_STATE_FILE=/opt/ultrabridge-ledger/state.json

# Anthropic API key for handwriting OCR (Claude Sonnet)
ANTHROPIC_API_KEY=

# Ultrabridge CalDAV credentials (for creating tasks from planner checkboxes)
UB_TASKS_URL=https://your-ultrabridge.example.com/tasks
UB_TASKS_USER=admin
UB_TASKS_PASS=

# Only create tasks for pages within this many days (avoids flooding old history)
TASK_CREATE_LOOKBACK_DAYS=7

# Optional: forward OCR'd data to a webhook endpoint (leave blank to skip)
LEDGER_WEBHOOK_URL=
LEDGER_WEBHOOK_SECRET=
